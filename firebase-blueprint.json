{
  "entities": {
    "project": {
      "title": "Project",
      "description": "A CAD project containing layers and entities.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "ownerId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "ownerId", "createdAt"]
    },
    "layer": {
      "title": "Layer",
      "description": "A drawing layer in a project.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "visible": { "type": "boolean" }
      },
      "required": ["id", "name", "color", "visible"]
    },
    "point": {
      "title": "Point",
      "description": "A survey point entity.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "layerName": { "type": "string" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      },
      "required": ["id", "layerName", "x", "y"]
    },
    "line": {
      "title": "Line",
      "description": "A single line entity.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "layerName": { "type": "string" },
        "startX": { "type": "number" },
        "startY": { "type": "number" },
        "endX": { "type": "number" },
        "endY": { "type": "number" }
      },
      "required": ["id", "layerName", "startX", "startY", "endX", "endY"]
    },
    "polyline": {
      "title": "Polyline",
      "description": "A sequence of connected lines.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "layerName": { "type": "string" },
        "points": { "type": "array" },
        "isClosed": { "type": "boolean" }
      },
      "required": ["id", "layerName", "points", "isClosed"]
    },
    "polygon": {
      "title": "Polygon",
      "description": "A closed area entity.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "layerName": { "type": "string" },
        "points": { "type": "array" }
      },
      "required": ["id", "layerName", "points"]
    },
    "text": {
      "title": "Text",
      "description": "A text entity.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "layerName": { "type": "string" },
        "text": { "type": "string" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "height": { "type": "number" },
        "rotation": { "type": "number" }
      },
      "required": ["id", "layerName", "text", "x", "y", "height"]
    }
  },
  "firestore": {
    "/projects/{projectId}": {
      "schema": "project",
      "description": "User projects."
    },
    "/projects/{projectId}/layers/{layerId}": {
      "schema": "layer",
      "description": "Layers within a project."
    },
    "/projects/{projectId}/points/{pointId}": {
      "schema": "point",
      "description": "Points within a project."
    },
    "/projects/{projectId}/lines/{lineId}": {
      "schema": "line",
      "description": "Lines within a project."
    },
    "/projects/{projectId}/polylines/{polylineId}": {
      "schema": "polyline",
      "description": "Polylines within a project."
    },
    "/projects/{projectId}/polygons/{polygonId}": {
      "schema": "polygon",
      "description": "Polygons within a project."
    },
    "/projects/{projectId}/texts/{textId}": {
      "schema": "text",
      "description": "Texts within a project."
    }
  }
}
